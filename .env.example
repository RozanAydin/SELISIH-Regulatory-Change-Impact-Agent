# ==========================================
# SELISIH - Contoh Konfigurasi Lingkungan
# ==========================================
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah commit file `.env` (sudah ditangani .gitignore).
# Alternatif lain: isi di `.streamlit/secrets.toml` (untuk runtime streamlit).

# Base URL Langflow (tanpa slash di akhir)
LANGFLOW_API_URL=http://localhost:7860

# ID flow Langflow (dapat dari URL/ui saat membuka flow, contoh: a1b2c3f4-...)
LANGFLOW_FLOW_ID=

# Token / API key Langflow (kosongkan jika auto-login tanpa auth)
LANGFLOW_API_TOKEN=

# ==========================================
# MCP server lokal (jembatan ke IBM Bob) — lihat mcp_server.py
# ==========================================
# Port HTTP admin yang dipakai dashboard app.py untuk /health & /handoff
MCP_ADMIN_PORT=8765

# Alamat yang dipanggil dashboard (app.py) terhadap server MCP lokal
MCP_ADMIN_URL=http://127.0.0.1:8765

# ==========================================
# Lisensi lokal dashboard (license gate)
# ==========================================
SELISIH_ORG_NAME=PT Bank Digital Nusantara
SELISIH_PLAN=starter
SELISIH_LICENSE_STATUS=active
SELISIH_ACTIVE_REPOS=3
SELISIH_REPO_LIMIT=5
