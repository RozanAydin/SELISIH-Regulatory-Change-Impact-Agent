              }
            }
          }
        }
      },
      {
        "id": "WatsonxGranite-001",
        "type": "WatsonxLLM",
        "data": {
          "node": {
            "display_name": "IBM watsonx.ai (Granite 13B / 20B)",
            "description": "Model LLM fondasi untuk diferensiasi regulasi finansial dan verifikasi sitasi hukum tanpa halusinasi.",
            "template": {
              "model_id": {
                "type": "str",
