        "data": {
          "node": {
            "display_name": "Regulasi Baru OJK (Input Teks / Dokumen)",
            "description": "Menerima teks POJK pembaruan hasil ekstraksi JDIH OJK (contoh: POJK Nomor 22 Tahun 2023).",
            "template": {
              "input_value": {
                "type": "str",
                "required": true,
                "value": "POJK Nomor 22 Tahun 2023 tentang Pelindungan Konsumen dan Masyarakat di Sektor Jasa Keuangan"
              }
            }
          }
        }
      },
      {
        "id": "ChromaDB-001",
        "type": "Chroma",
        "data": {
          "node": {
            "display_name": "ChromaDB Local Vector Store (Regulasi Acuan)",
            "description": "Penyimpanan vektor lokal klausul POJK terdahulu (POJK 77/2016) tersimpan secara offline di data/chroma_db/.",
            "template": {
              "collection_name": {
                "type": "str",
                "value": "pojk_acuan_idx"
