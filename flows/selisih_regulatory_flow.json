{
  "name": "SELISIH — Regulatory Diff Pipeline",
  "description": "Pipeline analisis regulasi kepatuhan OJK: ingest regulasi baru, bandingkan terhadap basis data regulasi acuan di ChromaDB lokal, ekstrak pasal terdampak, dan petakan evidence ke source code.",
  "endpoint_name": "selisih-regulatory-diff",
  "data": {
    "nodes": [
